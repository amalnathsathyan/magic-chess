{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@solana/web3.js": ["./node_modules/@solana/web3.js"],
      "@solana/spl-token": ["./node_modules/@solana/spl-token"],
      "@anchor-lang/core": ["./node_modules/@anchor-lang/core"],
      "@magicblock-labs/ephemeral-rollups-kit": ["./node_modules/@magicblock-labs/ephemeral-rollups-kit"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
