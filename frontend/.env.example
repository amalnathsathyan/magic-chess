# Magic Chess — Environment Configuration (Devnet)
# Copy this to .env.local and fill in your keys.
# .env.local is gitignored — never commit secrets.

# ── Solana ───────────────────────────────────────────
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# ── MagicBlock Ephemeral Rollups ──────────────────────
# Magic Router (resolves ER shard FQDN for delegated accounts)
NEXT_PUBLIC_MAGICBLOCK_ROUTER_ENDPOINT=https://devnet-router.magicblock.app
# ER validator endpoints (region-specific, US is default)
NEXT_PUBLIC_MAGICBLOCK_ER_ENDPOINT=https://devnet-us.magicblock.app
# TEE endpoint for secure session key operations
NEXT_PUBLIC_MAGICBLOCK_TEE_ENDPOINT=https://devnet-tee.magicblock.app

# ── Program ───────────────────────────────────────────
NEXT_PUBLIC_PROGRAM_ID=5Ro6jsg6ov1VmEQ7Un5NAaydyfpUKDvABCK5CE5qN5E6

# ── Privy Auth ────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side secret (for gas sponsorship relay, never exposed to browser)
PRIVY_APP_SECRET=
