# ── Database (Supabase) ─────────────────────────────
# Get this from Supabase dashboard → Connect.
# Use direct (IPv6) or session pooler (IPv4) for a persistent container.
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ── Solana ──────────────────────────────────────────
RPC_ENDPOINT=https://api.devnet.solana.com
# Or use Helius free tier for better reliability:
# RPC_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
PROGRAM_ID=FbXiX6xcMRPVuTc7AZkQMSbpKa1uBzQY16NFf5jhJC7h
MAGICBLOCK_ROUTER=https://devnet-router.magicblock.app/
WAGER_MINT=So11111111111111111111111111111111111111112
PLATFORM_FEE_WALLET=5qLADWwuHGpEDaj5CNZhLaotrXxSXg8pXddU9qjQA5BJ

# ── Custom Solana gas sponsorship (backend secrets only) ──
# Base58-encoded 64-byte secret key. Never use this in frontend env files or
# in a NEXT_PUBLIC_* variable. Use your hosting provider's secret store.
SOLANA_FEE_PAYER_PRIVATE_KEY=<base58-encoded-64-byte-secret-key>
SOLANA_FEE_PAYER_ADDRESS=BuMLxTELQyTyNxroqFGHJprL1sdVMyQJ7om3MQUGToPQ
PRIVY_APP_ID=cmsdk4zc7003y0cjlc22j9igy
# Dashboard → Configuration → App settings → Basics → Verify with key instead
PRIVY_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n<public-key>\n-----END PUBLIC KEY-----"
SPONSOR_REQUESTS_PER_MINUTE=10
SPONSOR_MAX_WAGER_LAMPORTS=1000000000

# ── Server ──────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:3000,https://arena-dev.chessmagic.workers.dev
NODE_ENV=development
# Shared secret for sync endpoint authentication
API_KEY=your-secret-api-key
# Set false when migrations run as a separate release/deploy job.
RUN_MIGRATIONS_ON_START=true
