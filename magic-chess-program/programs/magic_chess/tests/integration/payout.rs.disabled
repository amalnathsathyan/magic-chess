// tests/payout_integration.rs
//
// LiteSVM-based payout/token integration tests for the Magic Chess Anchor program.
//
// 7 tests covering:
//   1. Winner payout correct
//   2. Draw payout split
//   3. Platform fee calculation
//   4. Escrow fully drained after payout
//   5. Duplicate settlement rejected
//   6. Wrong winner rejected
//   7. Full multi-instruction flow: create -> join -> make moves -> checkmate -> settle

use solana_program::{
    account_info::AccountInfo,
    entrypoint::ProgramResult,
    instruction::{AccountMeta, Instruction},
    program_pack::Pack,
    pubkey::Pubkey,
    system_program,
    hash,
};
use solana_program_test::*;
use solana_sdk::{
    signature::{Keypair, Signer},
    transaction::Transaction,
};
use spl_associated_token_account::get_associated_token_address;

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

/// The on-chain program ID — must match declare_id!() in lib.rs
const PROGRAM_ID: Pubkey = Pubkey::from_str_const(
    "F8MMYzGxdXdtKTkGqUJvDrmTWm8bBb1zyajLT1s5tpMe",
);

// PDA seed prefixes (mirrors constants.rs)
const CHESS_MATCH_SEED: &[u8] = b"chess_match";
const MATCH_ESCROW_SEED: &[u8] = b"match_escrow";

// Anchor discriminator for the ChessMatch account type
// sha256("account:ChessMatch")[..8]
const CHESS_MATCH_DISCRIMINATOR: [u8; 8] = [72, 241, 122, 67, 252, 229, 79, 237];

// ---------------------------------------------------------------------------
// PDA helpers
// ---------------------------------------------------------------------------

fn find_chess_match_pda(match_id: &str) -> (Pubkey, u8) {
    Pubkey::find_program_address(
        &[CHESS_MATCH_SEED, match_id.as_bytes()],
        &PROGRAM_ID,
    )
}

fn find_match_escrow_pda(match_id: &str) -> (Pubkey, u8) {
    Pubkey::find_program_address(
        &[MATCH_ESCROW_SEED, match_id.as_bytes()],
        &PROGRAM_ID,
    )
}

// ---------------------------------------------------------------------------
// Anchor instruction discriminator
// ---------------------------------------------------------------------------

/// Compute the 8-byte Anchor instruction discriminator: sha256("global:<name>")[..8]
fn ix_discriminator(name: &str) -> [u8; 8] {
    let mut d = [0u8; 8];
    let preimage = format!("global:{}", name);
    let h = hash::hash(preimage.as_bytes());
    d.copy_from_slice(&h.to_bytes()[..8]);
    d
}

// ---------------------------------------------------------------------------
// Borsh serialization helpers for instruction args
// ---------------------------------------------------------------------------

/// Anchor's borsh encoding for String: u32 LE length prefix + UTF-8 bytes.
fn borsh_ser_string(buf: &mut Vec<u8>, s: &str) {
    let len = s.len() as u32;
    buf.extend_from_slice(&len.to_le_bytes());
    buf.extend_from_slice(s.as_bytes());
}

fn borsh_ser_u64(buf: &mut Vec<u8>, v: u64) {
    buf.extend_from_slice(&v.to_le_bytes());
}

fn borsh_ser_i64(buf: &mut Vec<u8>, v: i64) {
    buf.extend_from_slice(&v.to_le_bytes());
}

fn borsh_ser_u16(buf: &mut Vec<u8>, v: u16) {
    buf.extend_from_slice(&v.to_le_bytes());
}

fn borsh_ser_pubkey(buf: &mut Vec<u8>, k: &Pubkey) {
    buf.extend_from_slice(&k.to_bytes());
}

// ---------------------------------------------------------------------------
// ChessMatch account data helpers
// ---------------------------------------------------------------------------

/// On-chain field layout for ChessMatch (after the 8-byte Anchor discriminator).
///
/// ChessMatch is serialized via borsh with InitSpace. Size per field:
///   match_id:             String (max_len=32) -> 4 + 32 = 36 bytes     [offset   0]
///   players[0]:           Pubkey              -> 32 bytes              [offset  36]
///   players[1]:           Pubkey              -> 32 bytes              [offset  68]
///   current_player_idx:   u8                  -> 1 byte                [offset 100]
///   current_turn:         PlayerColor (enum)  -> 1 byte                [offset 101]
///   last_move_timestamp:  i64                 -> 8 bytes               [offset 102]
///   move_timeout_duration:i64                 -> 8 bytes               [offset 110]
///   game_status:          GameStatus (enum)   -> 1 byte                [offset 118]
///   game_end_reason:      Option<GameEndReason> -> 1+1 = 2 bytes       [offset 119]
///   board:                [[Option<Piece>;8];8] -> 8*8*3 = 192 bytes   [offset 121]
///   castling_rights:      CastlingRights (4 bools) -> 4 bytes          [offset 313]
///   en_passant_target:    Option<EnPassantSquare> -> 1+2 = 3 bytes     [offset 317]
///   halfmove_clock:       u8                  -> 1 byte                [offset 320]
///   fullmove_number:      u16                 -> 2 bytes               [offset 321]
///   betting_token_mint:   Pubkey              -> 32 bytes              [offset 323]
///   bet_amount_player_one:u64                 -> 8 bytes               [offset 355]
///   bet_amount_player_two:u64                 -> 8 bytes               [offset 363]
///   total_pot:            u64                 -> 8 bytes               [offset 371]
///   platform_fee_basis_points: u16            -> 2 bytes               [offset 379]
///   platform_fee_wallet:  Pubkey              -> 32 bytes              [offset 381]
///   payout_processed:     bool                -> 1 byte                [offset 413]
///   prediction_enabled:   bool                -> 1 byte                [offset 414]
///   bump:                 u8                  -> 1 byte                [offset 415]
///   match_escrow_bump:    u8                  -> 1 byte                [offset 416]
///
/// Total size after discriminator: 417 bytes.

// Offsets (after the 8-byte Anchor discriminator; use as data[8 + OFFSET_*])
const OFFSET_GAME_STATUS: usize = 118;
const OFFSET_GAME_END_REASON: usize = 119;
const OFFSET_TOTAL_POT: usize = 371;
const OFFSET_PAYOUT_PROCESSED: usize = 413;

/// GameStatus enum values (must match src/state/enums.rs)
#[repr(u8)]
#[allow(dead_code)]
enum GameStatusVal {
    WaitingForOpponent = 0,
    Active = 1,
    WhiteWins = 2,
    BlackWins = 3,
    Draw = 4,
}

/// GameEndReason enum values (must match src/state/enums.rs)
#[repr(u8)]
#[allow(dead_code)]
enum GameEndReasonVal {
    Checkmate = 0,
    Stalemate = 1,
    Resignation = 2,
    Timeout = 3,
    FiftyMoveRule = 4,
    ThreefoldRepetition = 5,
}

// ---------------------------------------------------------------------------
// Token helpers
// ---------------------------------------------------------------------------

async fn create_mint(
    banks_client: &mut BanksClient,
    payer: &Keypair,
    mint: &Keypair,
    decimals: u8,
) -> Pubkey {
    let mint_pk = mint.pubkey();
    let rent = banks_client.get_rent().await.unwrap();
    let mint_size = spl_token::state::Mint::LEN;

    let create_ix = solana_sdk::system_instruction::create_account(
        &payer.pubkey(),
        &mint_pk,
        rent.minimum_balance(mint_size),
        mint_size as u64,
        &spl_token::ID,
    );

    let init_ix = spl_token::instruction::initialize_mint(
        &spl_token::ID,
        &mint_pk,
        &payer.pubkey(),
        None,
        decimals,
    )
    .unwrap();

    let tx = Transaction::new_signed_with_payer(
        &[create_ix, init_ix],
        Some(&payer.pubkey()),
        &[payer, mint],
        banks_client.get_latest_blockhash().await.unwrap(),
    );
    banks_client.process_transaction(tx).await.unwrap();
    mint_pk
}

async fn create_ata(
    banks_client: &mut BanksClient,
    payer: &Keypair,
    owner: &Pubkey,
    mint: &Pubkey,
) -> Pubkey {
    let ata = get_associated_token_address(owner, mint);

    let ix = spl_associated_token_account::instruction::create_associated_token_account(
        &payer.pubkey(),
        owner,
        mint,
        &spl_token::ID,
    );

    let tx = Transaction::new_signed_with_payer(
        &[ix],
        Some(&payer.pubkey()),
        &[payer],
        banks_client.get_latest_blockhash().await.unwrap(),
    );
    banks_client.process_transaction(tx).await.unwrap();
    ata
}

async fn mint_tokens(
    banks_client: &mut BanksClient,
    payer: &Keypair,
    mint: &Pubkey,
    destination: &Pubkey,
    amount: u64,
) {
    let ix = spl_token::instruction::mint_to(
        &spl_token::ID,
        mint,
        destination,
        &payer.pubkey(),
        &[],
        amount,
    )
    .unwrap();

    let tx = Transaction::new_signed_with_payer(
        &[ix],
        Some(&payer.pubkey()),
        &[payer],
        banks_client.get_latest_blockhash().await.unwrap(),
    );
    banks_client.process_transaction(tx).await.unwrap();
}

async fn get_token_balance(
    banks_client: &mut BanksClient,
    ata: &Pubkey,
) -> u64 {
    let account = banks_client.get_account(*ata).await.unwrap().unwrap();
    let token_account = spl_token::state::TokenAccount::unpack(&account.data).unwrap();
    token_account.amount
}

// ---------------------------------------------------------------------------
// Instruction builders
// ---------------------------------------------------------------------------

fn build_initialize_ix(
    match_id: &str,
    bet_amount: u64,
    timeout: i64,
    fee_bps: u16,
    fee_wallet: Pubkey,
    player: &Keypair,
    player_ata: Pubkey,
    mint: Pubkey,
    chess_match_pda: Pubkey,
    match_escrow_pda: Pubkey,
) -> Instruction {
    let mut data = ix_discriminator("initialize_match").to_vec();
    borsh_ser_string(&mut data, match_id);
    borsh_ser_u64(&mut data, bet_amount);
    borsh_ser_i64(&mut data, timeout);
    borsh_ser_u16(&mut data, fee_bps);
    borsh_ser_pubkey(&mut data, &fee_wallet);

    let accounts = vec![
        AccountMeta::new(chess_match_pda, false),
        AccountMeta::new(player.pubkey(), true),
        AccountMeta::new_readonly(mint, false),
        AccountMeta::new(player_ata, false),
        AccountMeta::new(match_escrow_pda, false),
        AccountMeta::new_readonly(spl_token::ID, false),
        AccountMeta::new_readonly(system_program::ID, false),
    ];

    Instruction {
        program_id: PROGRAM_ID,
        accounts,
        data,
    }
}

fn build_join_ix(
    bet_amount: u64,
    player_two: &Keypair,
    player_two_ata: Pubkey,
    chess_match_pda: Pubkey,
    match_escrow_pda: Pubkey,
) -> Instruction {
    let mut data = ix_discriminator("join_match").to_vec();
    borsh_ser_u64(&mut data, bet_amount);

    let accounts = vec![
        AccountMeta::new(chess_match_pda, false),
        AccountMeta::new(player_two.pubkey(), true),
        AccountMeta::new(player_two_ata, false),
        AccountMeta::new(match_escrow_pda, false),
        AccountMeta::new_readonly(spl_token::ID, false),
        AccountMeta::new_readonly(system_program::ID, false),
    ];

    Instruction {
        program_id: PROGRAM_ID,
        accounts,
        data,
    }
}

fn build_resign_ix(
    chess_match_pda: Pubkey,
    resigning_player: &Keypair,
) -> Instruction {
    let data = ix_discriminator("resign_game").to_vec();

    let accounts = vec![
        AccountMeta::new(chess_match_pda, false),
        AccountMeta::new(resigning_player.pubkey(), true),
    ];

    Instruction {
        program_id: PROGRAM_ID,
        accounts,
        data,
    }
}

fn build_settle_ix(
    chess_match_pda: Pubkey,
    match_escrow_pda: Pubkey,
    player_one_ata: Pubkey,
    player_two_ata: Pubkey,
    platform_fee_ata: Pubkey,
) -> Instruction {
    let data = ix_discriminator("process_match_settlement").to_vec();

    let accounts = vec![
        AccountMeta::new(chess_match_pda, false),
        AccountMeta::new(match_escrow_pda, false),
        AccountMeta::new(player_one_ata, false),
        AccountMeta::new(player_two_ata, false),
        AccountMeta::new(platform_fee_ata, false),
        AccountMeta::new_readonly(spl_token::ID, false),
    ];

    Instruction {
        program_id: PROGRAM_ID,
        accounts,
        data,
    }
}

// ---------------------------------------------------------------------------
// MakeMove instruction builder (for Test 7 — full flow)
// ---------------------------------------------------------------------------

fn build_make_move_ix(
    chess_match_pda: Pubkey,
    player: &Keypair,
    from_row: u8,
    from_col: u8,
    to_row: u8,
    to_col: u8,
    promotion: Option<u8>, // None=0xff or just skip; PieceType as u8
) -> Instruction {
    let mut data = ix_discriminator("make_move").to_vec();
    // MakeMoveArgs: from_row: u8, from_col: u8, to_row: u8, to_col: u8
    data.push(from_row);
    data.push(from_col);
    data.push(to_row);
    data.push(to_col);
    // promotion: Option<PieceType>
    // PieceType enum: Pawn=0, Knight=1, Bishop=2, Rook=3, Queen=4, King=5
    // Option<T> in borsh: 1 byte prefix (0 = None, 1 = Some), then value
    match promotion {
        Some(p) => {
            data.push(1); // Some
            data.push(p); // PieceType variant
        }
        None => {
            data.push(0); // None
        }
    }

    let accounts = vec![
        AccountMeta::new(chess_match_pda, false),
        AccountMeta::new(player.pubkey(), true),
    ];

    Instruction {
        program_id: PROGRAM_ID,
        accounts,
        data,
    }
}

// ---------------------------------------------------------------------------
// Entrypoint wrapper for solana-program-test processor!()
// ---------------------------------------------------------------------------

/// The test entrypoint delegates to the Anchor-generated dispatch logic.
/// Anchor 1.1.2 generates a public `entrypoint` function (via the solana_program::entrypoint!
/// macro) at the crate root, which calls the #[program]-annotated module's `entry` function.
///
/// If `magic_chess::entrypoint` or `magic_chess::entry` does not compile, the test harness
/// can use ProgramTest::new("magic_chess", magic_chess::ID, None) and add the program from a
/// BPF binary instead.
fn program_entrypoint(
    program_id: &Pubkey,
    accounts: &[AccountInfo],
    instruction_data: &[u8],
) -> ProgramResult {
    magic_chess::entrypoint(program_id, accounts, instruction_data)
}

// ---------------------------------------------------------------------------
// Test harness setup helper
// ---------------------------------------------------------------------------

struct TestContext {
    pub banks_client: BanksClient,
    pub payer: Keypair,
    pub mint: Pubkey,
    pub mint_authority: Keypair,
    pub player1: Keypair,
    pub player2: Keypair,
    pub player1_ata: Pubkey,
    pub player2_ata: Pubkey,
    pub platform_wallet: Keypair,
    pub platform_ata: Pubkey,
    pub match_id: String,
    pub chess_match_pda: Pubkey,
    pub match_escrow_pda: Pubkey,
}

impl TestContext {
    async fn new(match_id: &str, bet_amount: u64, fee_bps: u16) -> Self {
        let mut program_test = ProgramTest::new(
            "magic_chess",
            magic_chess::ID,
            processor!(program_entrypoint),
        );

        // Add a funded payer
        let payer = Keypair::new();
        program_test.add_account(
            payer.pubkey(),
            solana_sdk::account::Account {
                lamports: 1_000_000_000_000, // 1000 SOL
                data: vec![],
                owner: system_program::ID,
                executable: false,
                rent_epoch: 0,
            },
        );

        let (mut banks_client, payer, recent_hash) = program_test.start().await;

        let mint_keypair = Keypair::new();
        let mint = mint_keypair.pubkey();

        // Create mint
        create_mint(&mut banks_client, &payer, &mint_keypair, 9).await;

        let player1 = Keypair::new();
        let player2 = Keypair::new();
        let platform_wallet = Keypair::new();

        // Fund player + platform accounts with lamports for ATA creation
        let fund_amount = 100_000_000_000u64; // 100 SOL
        for who in [&player1, &player2, &platform_wallet] {
            let ix = solana_sdk::system_instruction::transfer(
                &payer.pubkey(),
                &who.pubkey(),
                fund_amount,
            );
            let tx = Transaction::new_signed_with_payer(
                &[ix],
                Some(&payer.pubkey()),
                &[&payer],
                recent_hash,
            );
            banks_client.process_transaction(tx).await.unwrap();
        }

        // Create ATAs
        let player1_ata = create_ata(&mut banks_client, &payer, &player1.pubkey(), &mint).await;
        let player2_ata = create_ata(&mut banks_client, &payer, &player2.pubkey(), &mint).await;
        let platform_ata =
            create_ata(&mut banks_client, &payer, &platform_wallet.pubkey(), &mint).await;

        // Mint tokens to players
        mint_tokens(&mut banks_client, &payer, &mint, &player1_ata, bet_amount * 10).await;
        mint_tokens(&mut banks_client, &payer, &mint, &player2_ata, bet_amount * 10).await;

        // Derive PDAs
        let (chess_match_pda, _chess_bump) = find_chess_match_pda(match_id);
        let (match_escrow_pda, _escrow_bump) = find_match_escrow_pda(match_id);

        // Initialize the match (player1 creates)
        let init_ix = build_initialize_ix(
            match_id,
            bet_amount,
            300, // timeout
            fee_bps,
            platform_wallet.pubkey(),
            &player1,
            player1_ata,
            mint,
            chess_match_pda,
            match_escrow_pda,
        );

        // Join the match (player2 joins with matching bet)
        let join_ix = build_join_ix(
            bet_amount,
            &player2,
            player2_ata,
            chess_match_pda,
            match_escrow_pda,
        );

        // Execute init + join in one transaction
        let tx = Transaction::new_signed_with_payer(
            &[init_ix, join_ix],
            Some(&payer.pubkey()),
            &[&payer, &player1, &player2],
            banks_client.get_latest_blockhash().await.unwrap(),
        );
        banks_client.process_transaction(tx).await.unwrap();

        TestContext {
            banks_client,
            payer,
            mint,
            mint_authority: mint_keypair,
            player1,
            player2,
            player1_ata,
            player2_ata,
            platform_wallet,
            platform_ata,
            match_id: match_id.to_string(),
            chess_match_pda,
            match_escrow_pda,
        }
    }

    /// Helper: read current token balances for all parties.
    async fn read_balances(&mut self) -> (u64, u64, u64, u64) {
        let p1 = get_token_balance(&mut self.banks_client, &self.player1_ata).await;
        let p2 = get_token_balance(&mut self.banks_client, &self.player2_ata).await;
        let plat = get_token_balance(&mut self.banks_client, &self.platform_ata).await;
        let escrow = get_token_balance(&mut self.banks_client, &self.match_escrow_pda).await;
        (p1, p2, plat, escrow)
    }

    /// Process settlement with recent blockhash from the client.
    async fn process_settlement(&mut self) {
        let settle_ix = build_settle_ix(
            self.chess_match_pda,
            self.match_escrow_pda,
            self.player1_ata,
            self.player2_ata,
            self.platform_ata,
        );
        let tx = Transaction::new_signed_with_payer(
            &[settle_ix],
            Some(&self.payer.pubkey()),
            &[&self.payer],
            self.banks_client.get_latest_blockhash().await.unwrap(),
        );
        self.banks_client.process_transaction(tx).await.unwrap();
    }

    /// Process settlement and expect failure.
    async fn process_settlement_expect_err(&mut self) {
        let settle_ix = build_settle_ix(
            self.chess_match_pda,
            self.match_escrow_pda,
            self.player1_ata,
            self.player2_ata,
            self.platform_ata,
        );
        let tx = Transaction::new_signed_with_payer(
            &[settle_ix],
            Some(&self.payer.pubkey()),
            &[&self.payer],
            self.banks_client.get_latest_blockhash().await.unwrap(),
        );
        let result = self.banks_client.process_transaction(tx).await;
        assert!(
            result.is_err(),
            "Expected settlement to fail, but it succeeded"
        );
    }

    /// Have player2 resign, giving player1 the win.
    async fn player2_resigns(&mut self) {
        let ix = build_resign_ix(self.chess_match_pda, &self.player2);
        let tx = Transaction::new_signed_with_payer(
            &[ix],
            Some(&self.payer.pubkey()),
            &[&self.payer, &self.player2],
            self.banks_client.get_latest_blockhash().await.unwrap(),
        );
        self.banks_client.process_transaction(tx).await.unwrap();
    }

    /// Have player1 resign, giving player2 the win.
    async fn player1_resigns(&mut self) {
        let ix = build_resign_ix(self.chess_match_pda, &self.player1);
        let tx = Transaction::new_signed_with_payer(
            &[ix],
            Some(&self.payer.pubkey()),
            &[&self.payer, &self.player1],
            self.banks_client.get_latest_blockhash().await.unwrap(),
        );
        self.banks_client.process_transaction(tx).await.unwrap();
    }

    /// Overwrite the `game_status` field in the on-chain ChessMatch account.
    /// Use this to test edge cases that can't be reached via normal move play.
    async fn set_game_status_raw(&mut self, status: GameStatusVal) {
        let acct = self
            .banks_client
            .get_account(self.chess_match_pda)
            .await
            .unwrap()
            .unwrap();

        let mut data = acct.data.clone();
        // Offset 8 (discr) + OFFSET_GAME_STATUS
        data[8 + OFFSET_GAME_STATUS] = status as u8;

        let mut new_acct = acct.clone();
        new_acct.data = data;

        self.banks_client
            .set_account(&self.chess_match_pda, &new_acct)
            .await
            .unwrap();
    }
}

// ---------------------------------------------------------------------------
// Test 1: Winner payout correct
// ---------------------------------------------------------------------------
// Player2 resigns -> Player1 wins.
// total_pot = 2 * bet_amount
// fee = total_pot * fee_bps / 10000
// winner_gets = total_pot - fee
// platform_gets = fee

#[tokio::test]
async fn test_winner_payout_correct() {
    const BET: u64 = 100;
    const FEE_BPS: u16 = 200; // 2%
    let mut ctx = TestContext::new("t1_winner_payout", BET, FEE_BPS).await;

    // Capture balances before settlement
    let (p1_before, p2_before, plat_before, escrow_before) = ctx.read_balances().await;
    // After init+join: escrow = BET * 2 = 200
    assert_eq!(escrow_before, BET * 2, "Escrow should hold both bets");

    // Player2 resigns -> WhiteWins (player1 wins)
    ctx.player2_resigns().await;

    // Process settlement
    ctx.process_settlement().await;

    let (p1_after, p2_after, plat_after, escrow_after) = ctx.read_balances().await;

    let total_pot: u64 = BET * 2; // 200
    let fee: u64 = total_pot * (FEE_BPS as u64) / 10_000; // 4
    let winner_amount: u64 = total_pot - fee; // 196

    assert_eq!(p1_after, p1_before + winner_amount,
        "Winner (player1) should receive total_pot - fee");
    assert_eq!(p2_after, p2_before,
        "Loser (player2) should not receive any tokens");
    assert_eq!(plat_after, plat_before + fee,
        "Platform should receive the fee");
    assert_eq!(escrow_after, 0, "Escrow must be fully drained");
}

// ---------------------------------------------------------------------------
// Test 2: Draw payout split
// ---------------------------------------------------------------------------
// Game ends in Draw -> both players get (total_pot - fee) / 2 each.

#[tokio::test]
async fn test_draw_payout_split() {
    const BET: u64 = 100;
    const FEE_BPS: u16 = 300; // 3%
    let mut ctx = TestContext::new("t2_draw_split", BET, FEE_BPS).await;

    let (p1_before, p2_before, plat_before, _) = ctx.read_balances().await;

    // Manually set game_status to Draw
    ctx.set_game_status_raw(GameStatusVal::Draw).await;

    ctx.process_settlement().await;

    let (p1_after, p2_after, plat_after, escrow_after) = ctx.read_balances().await;

    let total_pot: u64 = BET * 2; // 200
    let fee: u64 = total_pot * (FEE_BPS as u64) / 10_000; // 6
    let remaining: u64 = total_pot - fee; // 194
    let each_refund: u64 = remaining / 2; // 97 (one player gets 97, other gets remainder 97)

    // In draw, both players get refund minus fee split
    assert_eq!(p1_after, p1_before + each_refund,
        "Player1 should get half of remaining pot");
    // Player 2 gets the remainder (which might be 1 more due to integer division)
    let p2_expected = total_pot - fee - each_refund;
    assert_eq!(p2_after, p2_before + p2_expected,
        "Player2 gets the remainder");
    assert_eq!(plat_after, plat_before + fee,
        "Platform should receive the fee");
    assert_eq!(escrow_after, 0, "Escrow must be fully drained");
}

// ---------------------------------------------------------------------------
// Test 3: Platform fee calculation
// ---------------------------------------------------------------------------
// Verify that fee = total_pot * bps / 10000, using various fee rates.

#[tokio::test]
async fn test_platform_fee_calculation() {
    const BET: u64 = 500;
    const FEE_BPS: u16 = 500; // 5%
    let mut ctx = TestContext::new("t3_fee_calc", BET, FEE_BPS).await;

    ctx.player2_resigns().await;
    ctx.process_settlement().await;

    let (_, _, plat_after, _) = ctx.read_balances().await;

    let total_pot: u64 = BET * 2; // 1000
    let expected_fee: u64 = total_pot * (FEE_BPS as u64) / 10_000; // 50

    assert_eq!(plat_after, expected_fee,
        "Platform fee should exactly equal total_pot * bps / 10000");
}

// ---------------------------------------------------------------------------
// Test 4: Escrow fully drained after payout
// ---------------------------------------------------------------------------

#[tokio::test]
async fn test_escrow_fully_drained_after_payout() {
    const BET: u64 = 250;
    const FEE_BPS: u16 = 100; // 1%
    let mut ctx = TestContext::new("t4_escrow_drain", BET, FEE_BPS).await;

    // Verify escrow is funded
    let (_, _, _, escrow_before) = ctx.read_balances().await;
    assert_eq!(escrow_before, BET * 2, "Escrow should hold both bets");

    ctx.player2_resigns().await;
    ctx.process_settlement().await;

    let (_, _, _, escrow_after) = ctx.read_balances().await;
    assert_eq!(escrow_after, 0, "Escrow balance must be 0 after settlement");

    // Sanity: all escrow tokens were distributed
    let total_pot: u64 = BET * 2;
    let fee: u64 = total_pot * (FEE_BPS as u64) / 10_000;
    assert!(fee > 0, "Fee should be nonzero for this test");
    assert!(fee < total_pot, "Fee should be less than total pot");
}

// ---------------------------------------------------------------------------
// Test 5: Duplicate settlement rejected
// ---------------------------------------------------------------------------

#[tokio::test]
async fn test_duplicate_settlement_rejected() {
    const BET: u64 = 100;
    const FEE_BPS: u16 = 200;
    let mut ctx = TestContext::new("t5_dup_reject", BET, FEE_BPS).await;

    ctx.player2_resigns().await;

    // First settlement: succeeds
    ctx.process_settlement().await;

    // Second settlement: must fail (payout_processed == true)
    ctx.process_settlement_expect_err().await;
}

// ---------------------------------------------------------------------------
// Test 6: Wrong winner rejected
// ---------------------------------------------------------------------------
// After a match where player2 resigns (WhiteWins), we modify game_status to
// BlackWins. Settlement tries to pay player_two_ata. Since the escrow balance
// constraint still passes but the actual payout logic may enforce the winner
// must be valid, this test verifies the payout logic rejects it when the
// game_status says the non-existent black player should get paid (but black
// was the one who resigned). Actually, the more direct test: we set game_status
// to WhiteWins but provide the wrong player_one_ata (owned by a third party),
// and the constraint `player_one_ata.owner == chess_match.players[0]`
// should fail.
//
// The simpler approach: create a fresh match, have player2 resign (WhiteWins),
// overwrite players[0] in ChessMatch to a bogus key, then settlement fails
// because player_one_ata.owner != chess_match.players[0].

#[tokio::test]
async fn test_wrong_winner_rejected() {
    const BET: u64 = 100;
    const FEE_BPS: u16 = 200;
    let mut ctx = TestContext::new("t6_wrong_winner", BET, FEE_BPS).await;

    ctx.player2_resigns().await;

    // Now player1 is the winner (WhiteWins). We'll corrupt the players[0]
    // field to point to a random key, making the ATA constraint fail.
    let acct = ctx
        .banks_client
        .get_account(ctx.chess_match_pda)
        .await
        .unwrap()
        .unwrap();

    // players[0] is at offset 8 (discr) + 36 (match_id) = 44 in account data
    let mut data = acct.data.clone();
    let random_key = Pubkey::new_unique();
    data[44..76].copy_from_slice(&random_key.to_bytes());

    let mut new_acct = acct.clone();
    new_acct.data = data;
    ctx.banks_client
        .set_account(&ctx.chess_match_pda, &new_acct)
        .await
        .unwrap();

    // Now settlement should fail because player_one_ata.owner != players[0]
    ctx.process_settlement_expect_err().await;
}

// ---------------------------------------------------------------------------
// Test 7: Full multi-instruction flow
// ---------------------------------------------------------------------------
// Complete lifecycle: initialize -> join -> make moves -> checkmate -> settle
//
// We play a short Fool's Mate-style sequence (fastest checkmate in chess):
// 1. f2-f3  (White pawn f2 to f3)
// 2. e7-e5  (Black pawn e7 to e5)
// 3. g2-g4  (White pawn g2 to g4)
// 4. d8-h4# (Black queen d8 to h4, checkmate)
//
// This is a real checkmate that the on-chain chess engine should validate.
// After the checkmate move, game_status becomes BlackWins.

#[tokio::test]
async fn test_full_flow_create_join_moves_checkmate_settle() {
    const BET: u64 = 200;
    const FEE_BPS: u16 = 250; // 2.5%

    // Use a standard TestContext setup but with the game still Active after init+join
    let mut ctx = TestContext::new("t7_full_flow", BET, FEE_BPS).await;

    let (p1_initial, p2_initial, _, escrow_initial) = ctx.read_balances().await;
    assert_eq!(escrow_initial, BET * 2, "Escrow should hold both bets");

    // --- Move 1: White f2-f3 ---
    // Board: rank 7=1st rank (white back), rank 0=8th rank (black back)
    // file 0=a, ..., file 7=h
    // f2 = (row=1, col=5)   [row 1 = rank 2 in 0-indexed]
    // f3 = (row=2, col=5)
    let ix1 = build_make_move_ix(
        ctx.chess_match_pda,
        &ctx.player1,
        1, 5,  // from: f2
        2, 5,  // to:   f3
        None,
    );
    let tx1 = Transaction::new_signed_with_payer(
        &[ix1],
        Some(&ctx.payer.pubkey()),
        &[&ctx.payer, &ctx.player1],
        ctx.banks_client.get_latest_blockhash().await.unwrap(),
    );
    ctx.banks_client.process_transaction(tx1).await.unwrap();

    // --- Move 2: Black e7-e5 ---
    // e7 = (row=6, col=4)
    // e5 = (row=4, col=4)
    let ix2 = build_make_move_ix(
        ctx.chess_match_pda,
        &ctx.player2,
        6, 4,  // from: e7
        4, 4,  // to:   e5
        None,
    );
    let tx2 = Transaction::new_signed_with_payer(
        &[ix2],
        Some(&ctx.payer.pubkey()),
        &[&ctx.payer, &ctx.player2],
        ctx.banks_client.get_latest_blockhash().await.unwrap(),
    );
    ctx.banks_client.process_transaction(tx2).await.unwrap();

    // --- Move 3: White g2-g4 ---
    // g2 = (row=1, col=6)
    // g4 = (row=3, col=6)
    let ix3 = build_make_move_ix(
        ctx.chess_match_pda,
        &ctx.player1,
        1, 6,  // from: g2
        3, 6,  // to:   g4
        None,
    );
    let tx3 = Transaction::new_signed_with_payer(
        &[ix3],
        Some(&ctx.payer.pubkey()),
        &[&ctx.payer, &ctx.player1],
        ctx.banks_client.get_latest_blockhash().await.unwrap(),
    );
    ctx.banks_client.process_transaction(tx3).await.unwrap();

    // --- Move 4: Black d8-h4 (Queen moves) — CHECKMATE ---
    // d8 = (row=7, col=3)
    // h4 = (row=3, col=7)
    let ix4 = build_make_move_ix(
        ctx.chess_match_pda,
        &ctx.player2,
        7, 3,  // from: d8
        3, 7,  // to:   h4
        None,
    );
    let tx4 = Transaction::new_signed_with_payer(
        &[ix4],
        Some(&ctx.payer.pubkey()),
        &[&ctx.payer, &ctx.player2],
        ctx.banks_client.get_latest_blockhash().await.unwrap(),
    );
    ctx.banks_client.process_transaction(tx4).await.unwrap();

    // Now the game should be BlackWins (player2 wins)
    // Read the ChessMatch account to verify
    let chess_acct = ctx
        .banks_client
        .get_account(ctx.chess_match_pda)
        .await
        .unwrap()
        .unwrap();
    let game_status_byte = chess_acct.data[8 + OFFSET_GAME_STATUS];
    assert_eq!(
        game_status_byte,
        GameStatusVal::BlackWins as u8,
        "Game should be BlackWins after checkmate (Fool's Mate)"
    );

    // --- Process settlement ---
    ctx.process_settlement().await;

    let (p1_after, p2_after, plat_after, escrow_after) = ctx.read_balances().await;

    let total_pot: u64 = BET * 2; // 400
    let fee: u64 = total_pot * (FEE_BPS as u64) / 10_000; // 10
    let winner_amount: u64 = total_pot - fee; // 390

    // Player2 (Black) wins
    assert_eq!(p2_after, p2_initial + winner_amount,
        "Winner (player2/Black) should receive total_pot - fee");
    assert_eq!(p1_after, p1_initial,
        "Loser (player1/White) should not receive any tokens");
    assert_eq!(plat_after, fee,
        "Platform should receive the fee");
    assert_eq!(escrow_after, 0,
        "Escrow must be fully drained after settlement");
}

// ---------------------------------------------------------------------------
// Additional: verify mollusk-svm dev-dependency is loadable (compile-time check)
// ---------------------------------------------------------------------------

/// Compile-time verification that mollusk-svm is available as a dev-dependency.
/// This module is never used at runtime — if the test binary compiles, the dep is valid.
#[cfg(test)]
#[allow(unused_imports, dead_code)]
mod _mollusk_available {
    use mollusk_svm;
}
