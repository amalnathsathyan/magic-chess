// cu_benchmarks.rs
//
// Mollusk-based Compute Unit (CU) benchmarks for the Magic Chess Anchor program.
//
// Each benchmark sets up the minimal required accounts, executes an instruction
// via Mollusk's local SVM, and reports the CU consumed.
//
// ── Prerequisites ──────────────────────────────────────────────────────────
//   1. Build the program:   anchor build
//      (produces target/deploy/magic_chess.so relative to workspace root)
//   2. Run the benchmarks:
//      cargo test --package magic_chess --test cu_benchmarks -- --nocapture
//
//   These tests run natively (not via cargo test-sbf). Mollusk provides its
//   own SVM runtime that loads and executes the compiled BPF .so file.
//
// ── Expected CU Budget ─────────────────────────────────────────────────────
//   The program's default compute budget is 200 000 CU. Each benchmark
//   validates that the instruction stays well within this limit.
// ───────────────────────────────────────────────────────────────────────────

use mollusk_svm::Mollusk;
use solana_sdk::{
    account::{AccountSharedData, WritableAccount},
    hash::hash,
    instruction::{AccountMeta, Instruction},
    pubkey::Pubkey,
    signer::Signer,
    signature::Keypair,
};
use std::str::FromStr;

// ── Program identity ───────────────────────────────────────────────────────
const PROGRAM_ID_STR: &str = "F8MMYzGxdXdtKTkGqUJvDrmTWm8bBb1zyajLT1s5tpMe";
const PROGRAM_SO_PATH: &str = "target/deploy/magic_chess.so";

// ── PDA seeds (must match constants.rs) ────────────────────────────────────
const CHESS_MATCH_SEED: &[u8] = b"chess_match";
const MATCH_ESCROW_SEED: &[u8] = b"match_escrow";

// ── CU budget ceiling ──────────────────────────────────────────────────────
const CU_BUDGET: u64 = 200_000;

// ── SPL Token program ID ───────────────────────────────────────────────────
// anchor_spl::token::ID
const TOKEN_PROGRAM_ID_STR: &str = "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA";

// ============================================================================
//  Helpers
// ============================================================================

/// Load the program ID from its string constant.
fn program_id() -> Pubkey {
    Pubkey::from_str(PROGRAM_ID_STR).unwrap()
}

/// Compute an Anchor-style 8-byte instruction or account discriminator.
///
/// Anchor discriminators are the first 8 bytes of SHA-256("global:<name>")
/// for instructions and SHA-256("account:<AccountName>") for account types.
fn anchor_discriminator(namespace: &str, name: &str) -> [u8; 8] {
    let preimage = format!("{}:{}", namespace, name);
    let digest = hash(preimage.as_bytes());
    let mut disc = [0u8; 8];
    disc.copy_from_slice(&digest.to_bytes()[..8]);
    disc
}

fn instruction_disc(name: &str) -> [u8; 8] {
    anchor_discriminator("global", name)
}

fn account_discriminator(name: &str) -> [u8; 8] {
    anchor_discriminator("account", name)
}

/// Build make_move instruction data:
///   [8-byte discriminator] + Borsh(MakeMoveArgs)
///
///   MakeMoveArgs layout (Borsh):
///     from_row:  u8
///     from_col:  u8
///     to_row:    u8
///     to_col:    u8
///     promotion: Option<PieceType>  → 1-byte tag  + 1-byte variant
fn build_make_move_ix_data(
    from_row: u8,
    from_col: u8,
    to_row: u8,
    to_col: u8,
    promotion: Option<u8>, // PieceType variant: 0=Pawn, 1=Knight, 2=Bishop, 3=Rook, 4=Queen, 5=King
) -> Vec<u8> {
    let mut data = Vec::with_capacity(8 + 5);
    data.extend_from_slice(&instruction_disc("make_move"));
    data.push(from_row);
    data.push(from_col);
    data.push(to_row);
    data.push(to_col);
    match promotion {
        Some(p) => {
            data.push(1u8); // Option::Some tag
            data.push(p);
        }
        None => {
            data.push(0u8); // Option::None tag
        }
    }
    data
}

/// Build initialize_match instruction data:
///   [8-byte discriminator] + Borsh args
///
///   Args layout:
///     match_id:                   String (4-byte len + utf8)
///     bet_amount:                 u64 (8 bytes LE)
///     move_timeout_duration:      i64 (8 bytes LE)
///     platform_fee_basis_points:  u16 (2 bytes LE)
///     platform_fee_wallet:        Pubkey (32 bytes)
fn build_init_match_ix_data(
    match_id: &str,
    bet_amount: u64,
    move_timeout_duration: i64,
    platform_fee_basis_points: u16,
    platform_fee_wallet: &Pubkey,
) -> Vec<u8> {
    let mut data = Vec::new();
    data.extend_from_slice(&instruction_disc("initialize_match"));

    // match_id: String
    let id_bytes = match_id.as_bytes();
    data.extend_from_slice(&(id_bytes.len() as u32).to_le_bytes());
    data.extend_from_slice(id_bytes);

    // bet_amount: u64
    data.extend_from_slice(&bet_amount.to_le_bytes());

    // move_timeout_duration: i64
    data.extend_from_slice(&move_timeout_duration.to_le_bytes());

    // platform_fee_basis_points: u16
    data.extend_from_slice(&platform_fee_basis_points.to_le_bytes());

    // platform_fee_wallet: Pubkey
    data.extend_from_slice(&platform_fee_wallet.to_bytes());

    data
}

// ============================================================================
//  ChessMatch account data builder
// ============================================================================
//
//  The raw account data layout (after the 8-byte anchor discriminator) matches
//  the Borsh-serialized ChessMatch struct.  Order of fields:
//
//    match_id:              String          (4-byte len + utf8, max 32)
//    players:               [Pubkey; 2]     (64 bytes flat)
//    current_player_idx:    u8
//    current_turn:          PlayerColor     (u8: 0=White, 1=Black)
//    last_move_timestamp:   i64             (8 bytes LE)
//    move_timeout_duration: i64             (8 bytes LE)
//    game_status:           GameStatus      (u8: 0=Waiting,1=Active,2=WWin,3=BWin,4=Draw)
//    game_end_reason:       Option<GameEndReason>  (1-byte tag + 1-byte variant)
//    board:                 [[Option<Piece>; 8]; 8]  (64 × (1 + 2) bytes max)
//    castling_rights:       CastlingRights  (4 bools = 4 bytes)
//    en_passant_target:     Option<EnPassantSquare>  (1-byte tag + 2 bytes)
//    halfmove_clock:        u8
//    fullmove_number:       u16             (2 bytes LE)
//    position_history:      Vec<u64>        (4-byte len + N × 8 bytes, max 200)
//    betting_token_mint:    Pubkey          (32 bytes)
//    bet_amount_player_one: u64             (8 bytes LE)
//    bet_amount_player_two: u64             (8 bytes LE)
//    total_pot:             u64             (8 bytes LE)
//    platform_fee_basis_points: u16         (2 bytes LE)
//    platform_fee_wallet:   Pubkey          (32 bytes)
//    payout_processed:      bool            (1 byte)
//    prediction_enabled:    bool            (1 byte)
//    bump:                  u8
//    match_escrow_bump:     u8
//
//  Piece: { piece_type: u8, color: u8 } = 2 bytes
//  Option<Piece>: 1-byte tag (0=None, 1=Some) + {0, 2} bytes

/// Geometry constants for the board.
const BOARD_ROWS: usize = 8;
const BOARD_COLS: usize = 8;

/// Piece type variants matching the `PieceType` enum.
mod piece_type {
    pub const PAWN: u8 = 0;
    pub const KNIGHT: u8 = 1;
    pub const BISHOP: u8 = 2;
    pub const ROOK: u8 = 3;
    pub const QUEEN: u8 = 4;
    pub const KING: u8 = 5;
}

/// Player color variants matching the `PlayerColor` enum.
mod player_color {
    pub const WHITE: u8 = 0;
    pub const BLACK: u8 = 1;
}

/// Board builder: a 64-entry grid where each entry is Option<(piece_type, color)>.
type BoardDef = [[Option<(u8, u8)>; BOARD_COLS]; BOARD_ROWS];

/// Build a board definition for the standard starting position.
fn starting_board_def() -> BoardDef {
    let mut board = [[None; BOARD_COLS]; BOARD_ROWS];

    // Pawns
    for col in 0..8 {
        board[1][col] = Some((piece_type::PAWN, player_color::WHITE));
        board[6][col] = Some((piece_type::PAWN, player_color::BLACK));
    }

    // Back-rank pieces (R,N,B,Q,K,B,N,R)
    let back_rank = [
        piece_type::ROOK,
        piece_type::KNIGHT,
        piece_type::BISHOP,
        piece_type::QUEEN,
        piece_type::KING,
        piece_type::BISHOP,
        piece_type::KNIGHT,
        piece_type::ROOK,
    ];
    for (col, &pt) in back_rank.iter().enumerate() {
        board[0][col] = Some((pt, player_color::WHITE));
        board[7][col] = Some((pt, player_color::BLACK));
    }

    board
}

/// Build a midgame board position (Scotch Game after 1.e4 e5 2.Nf3 Nc6 3.d4 exd4 4.Nxd4).
///
/// This is a rich midgame position with most pieces still on the board.
/// Black has ~25-35 legal moves, providing significant work for
/// `are_no_legal_moves()`.
fn midgame_board_def() -> BoardDef {
    let mut board = [[None; BOARD_COLS]; BOARD_ROWS];
    let w = player_color::WHITE;
    let b = player_color::BLACK;

    // ── White pieces ────────────────────────────────────────────────────
    board[0][4] = Some((piece_type::KING, w));       // Ke1
    board[0][3] = Some((piece_type::QUEEN, w));       // Qd1
    board[0][0] = Some((piece_type::ROOK, w));        // Ra1
    board[0][7] = Some((piece_type::ROOK, w));        // Rh1
    board[0][2] = Some((piece_type::BISHOP, w));      // Bc1
    board[0][5] = Some((piece_type::BISHOP, w));      // Bf1
    board[0][1] = Some((piece_type::KNIGHT, w));      // Nb1
    board[3][3] = Some((piece_type::KNIGHT, w));      // Nd4 (developed)
    // White pawns: a2, b2, c2, e4, f2, g2, h2  (no d-pawn — captured)
    board[1][0] = Some((piece_type::PAWN, w));
    board[1][1] = Some((piece_type::PAWN, w));
    board[1][2] = Some((piece_type::PAWN, w));
    board[3][4] = Some((piece_type::PAWN, w));        // e4
    board[1][5] = Some((piece_type::PAWN, w));
    board[1][6] = Some((piece_type::PAWN, w));
    board[1][7] = Some((piece_type::PAWN, w));

    // ── Black pieces ────────────────────────────────────────────────────
    board[7][4] = Some((piece_type::KING, b));        // Ke8
    board[7][3] = Some((piece_type::QUEEN, b));       // Qd8
    board[7][0] = Some((piece_type::ROOK, b));        // Ra8
    board[7][7] = Some((piece_type::ROOK, b));        // Rh8
    board[7][2] = Some((piece_type::BISHOP, b));      // Bc8
    board[7][5] = Some((piece_type::BISHOP, b));      // Bf8
    board[5][2] = Some((piece_type::KNIGHT, b));      // Nc6 (developed)
    board[7][6] = Some((piece_type::KNIGHT, b));      // Ng8
    board[4][4] = Some((piece_type::PAWN, b));        // e5
    // Black pawns: a7, b7, c7, f7, g7, h7  (no d-pawn or e-pawn position adjust)
    board[6][0] = Some((piece_type::PAWN, b));
    board[6][1] = Some((piece_type::PAWN, b));
    board[6][2] = Some((piece_type::PAWN, b));
    board[6][3] = Some((piece_type::PAWN, b));        // d7 (kept for complexity)
    board[6][5] = Some((piece_type::PAWN, b));
    board[6][6] = Some((piece_type::PAWN, b));
    board[6][7] = Some((piece_type::PAWN, b));

    board
}

/// Empty board with only kings (and optionally other pieces).
fn emptyish_board_with_kings() -> BoardDef {
    let mut board = [[None; BOARD_COLS]; BOARD_ROWS];
    board[0][4] = Some((piece_type::KING, player_color::WHITE));
    board[7][4] = Some((piece_type::KING, player_color::BLACK));
    board
}

/// Serialize a BoardDef into Borsh bytes.
fn serialize_board(board: &BoardDef) -> Vec<u8> {
    let mut buf = Vec::with_capacity(64 * 3);
    for row in 0..BOARD_ROWS {
        for col in 0..BOARD_COLS {
            match board[row][col] {
                None => buf.push(0u8),
                Some((pt, color)) => {
                    buf.push(1u8);
                    buf.push(pt);
                    buf.push(color);
                }
            }
        }
    }
    buf
}

/// Build the complete raw bytes for a ChessMatch account.
///
/// Returns a Vec<u8> ready to be used as `AccountSharedData` data.
fn build_chess_match_bytes(
    match_id: &str,
    player_white: &Pubkey,
    player_black: &Pubkey,
    current_player_idx: u8,
    current_turn: u8,
    game_status: u8, // 1 = Active
    board: &BoardDef,
    castling_rights: [bool; 4],
    en_passant_target: Option<(u8, u8)>,
    halfmove_clock: u8,
    fullmove_number: u16,
    bump: u8,
    match_escrow_bump: u8,
) -> Vec<u8> {
    let mut data = Vec::new();

    // 8-byte anchor account discriminator
    data.extend_from_slice(&account_discriminator("ChessMatch"));

    // match_id: String
    let id_bytes = match_id.as_bytes();
    data.extend_from_slice(&(id_bytes.len() as u32).to_le_bytes());
    data.extend_from_slice(id_bytes);

    // players: [Pubkey; 2]
    data.extend_from_slice(&player_white.to_bytes());
    data.extend_from_slice(&player_black.to_bytes());

    // current_player_idx: u8
    data.push(current_player_idx);

    // current_turn: PlayerColor (u8)
    data.push(current_turn);

    // last_move_timestamp: i64
    data.extend_from_slice(&0i64.to_le_bytes());

    // move_timeout_duration: i64
    data.extend_from_slice(&0i64.to_le_bytes());

    // game_status: GameStatus (u8)
    data.push(game_status);

    // game_end_reason: Option<GameEndReason>
    data.push(0u8); // None tag
                     // (no variant data since None)

    // board: [[Option<Piece>; 8]; 8]
    data.extend_from_slice(&serialize_board(board));

    // castling_rights: CastlingRights (4 bools as u8)
    for &b in &castling_rights {
        data.push(b as u8);
    }

    // en_passant_target: Option<EnPassantSquare>
    match en_passant_target {
        Some((row, col)) => {
            data.push(1u8);
            data.push(row);
            data.push(col);
        }
        None => {
            data.push(0u8);
        }
    }

    // halfmove_clock: u8
    data.push(halfmove_clock);

    // fullmove_number: u16
    data.extend_from_slice(&fullmove_number.to_le_bytes());

    // position_history: Vec<u64> (empty)
    data.extend_from_slice(&0u32.to_le_bytes());

    // betting_token_mint: Pubkey
    data.extend_from_slice(&Pubkey::default().to_bytes());

    // bet_amount_player_one: u64
    data.extend_from_slice(&100u64.to_le_bytes());

    // bet_amount_player_two: u64
    data.extend_from_slice(&0u64.to_le_bytes());

    // total_pot: u64
    data.extend_from_slice(&100u64.to_le_bytes());

    // platform_fee_basis_points: u16
    data.extend_from_slice(&0u16.to_le_bytes());

    // platform_fee_wallet: Pubkey
    data.extend_from_slice(&Pubkey::default().to_bytes());

    // payout_processed: bool
    data.push(0u8);

    // prediction_enabled: bool
    data.push(0u8);

    // bump: u8
    data.push(bump);

    // match_escrow_bump: u8
    data.push(match_escrow_bump);

    data
}

/// Convert raw account bytes into an `AccountSharedData` owned by the program.
fn account_from_bytes(data: Vec<u8>, owner: &Pubkey, lamports: u64) -> AccountSharedData {
    let space = data.len();
    let mut account = AccountSharedData::new(lamports, space, owner);
    account.set_data_from_slice(&data);
    account
}

// ============================================================================
//  Mollusk bootstrap
// ============================================================================

/// Create a Mollusk instance configured with the magic_chess program.
fn create_mollusk() -> Mollusk {
    Mollusk::new(&program_id(), PROGRAM_SO_PATH)
}

/// Create a keypair and print its pubkey for debugging.
fn random_signer() -> Keypair {
    Keypair::new()
}

/// Compute a PDA for the chess_match seed.
fn find_chess_match_pda(match_id: &str, prog_id: &Pubkey) -> (Pubkey, u8) {
    Pubkey::find_program_address(&[CHESS_MATCH_SEED, match_id.as_bytes()], prog_id)
}

/// Compute a PDA for the match_escrow seed.
fn find_match_escrow_pda(match_id: &str, prog_id: &Pubkey) -> (Pubkey, u8) {
    Pubkey::find_program_address(&[MATCH_ESCROW_SEED, match_id.as_bytes()], prog_id)
}

// ============================================================================
//  Benchmarks
// ============================================================================

/// Helper to run a make_move instruction and report CU.
fn run_make_move_bench(
    name: &str,
    match_id: &str,
    board: &BoardDef,
    current_turn: u8,
    from_row: u8,
    from_col: u8,
    to_row: u8,
    to_col: u8,
    promotion: Option<u8>,
    expected_min_cu: u64,
    expected_max_cu: u64,
) {
    let mollusk = create_mollusk();
    let prog_id = program_id();
    let player = random_signer();
    let player_pubkey = player.pubkey();

    // Build ChessMatch account
    let (match_pda, bump) = find_chess_match_pda(match_id, &prog_id);
    let opponent_pubkey = Pubkey::default(); // No opponent joined
    let match_data = build_chess_match_bytes(
        match_id,
        &player_pubkey,
        &opponent_pubkey,
        if current_turn == player_color::WHITE { 0 } else { 1 },
        current_turn,
        1, // game_status: Active
        board,
        [true, true, true, true], // all castling rights
        None, // no en passant
        0,    // halfmove_clock
        1,    // fullmove_number
        bump,
        255,
    );

    let match_account = account_from_bytes(match_data, &prog_id, 1_000_000_000);

    // Build instruction
    let ix_data = build_make_move_ix_data(from_row, from_col, to_row, to_col, promotion);
    let accounts = vec![
        AccountMeta::new(match_pda, false),
        AccountMeta::new(player_pubkey, true),
    ];
    let instruction = Instruction::new_with_bytes(prog_id, &ix_data, accounts);

    // Set up account data map for Mollusk
    let mollusk_accounts: Vec<(Pubkey, AccountSharedData)> = vec![
        (match_pda, match_account),
        (
            player_pubkey,
            AccountSharedData::new(1_000_000_000, 0, &solana_sdk::system_program::id()),
        ),
    ];

    // Run
    let result = mollusk.process_instruction(&instruction, &mollusk_accounts);
    let cu = result.compute_units_consumed;
    let status = if cu <= CU_BUDGET { "PASS" } else { "FAIL" };

    println!(
        "{status:>4} | {name:<45} | CU: {cu:>7}  (expected {expected_min_cu:>6}–{expected_max_cu:<6}, budget {CU_BUDGET})"
    );

    assert!(
        cu <= CU_BUDGET,
        "{name}: CU {cu} exceeds budget {CU_BUDGET}",
    );
    assert!(
        cu >= expected_min_cu,
        "{name}: CU {cu} below expected minimum {expected_min_cu}",
    );
}

// ── Benchmark 1: Simple pawn advance (baseline) ────────────────────────────
//
//  White e2(1,4) → e4(3,4).  The simplest possible move: no capture, no
//  path check, no promotion, no special rules triggered.
//
//  Expected: ~10 000 – 18 000 CU

#[test]
fn bench_01_pawn_advance_baseline() {
    run_make_move_bench(
        "01 pawn advance e2e4 (baseline)",
        "bench-01",
        &starting_board_def(),
        player_color::WHITE,
        1, 4,  // e2
        3, 4,  // e4
        None,  // no promotion
        8_000,
        20_000,
    );
}

// ── Benchmark 2: Knight move ──────────────────────────────────────────────
//
//  White Nb1(0,1) → Nc3(2,2).  Knight skips path-checking entirely; only
//  the L-shaped delta and destination occupancy are validated.
//
//  Expected: ~6 000 – 12 000 CU

#[test]
fn bench_02_knight_move() {
    run_make_move_bench(
        "02 knight Nb1c3 (no path check)",
        "bench-02",
        &starting_board_def(),
        player_color::WHITE,
        0, 1,  // b1
        2, 2,  // c3
        None,
        5_000,
        14_000,
    );
}

// ── Benchmark 3: Bishop across board (path check) ──────────────────────────
//
//  Bc1(0,2) → f4(3,5).  A four-square diagonal that must pass through
//  d2 and e3 — both clear in the starting position after e2-e4 has been
//  played.  Exercises is_path_clear_diagonal.
//
//  We use a slightly modified board: we clear the e2 pawn (so e2 is empty)
//  and move the bishop to c1.  In this custom board, Bc1→f4 tests the
//  diagonal path-clear check over 3 intermediate squares.
//
//  Expected: ~12 000 – 22 000 CU

#[test]
fn bench_03_bishop_path_check() {
    let mut board = starting_board_def();
    // Clear e2 pawn so bishop can travel from c1 through d2,e3 to f4
    board[1][4] = None; // remove e2 pawn

    run_make_move_bench(
        "03 bishop Bc1f4 (diagonal path check)",
        "bench-03",
        &board,
        player_color::WHITE,
        0, 2,  // c1
        3, 5,  // f4
        None,
        10_000,
        25_000,
    );
}

// ── Benchmark 4: Queen diagonal (longest path) ─────────────────────────────
//
//  Qd1(0,3) → h5(4,7).  A five-square diagonal that must pass through
//  e2, f3, g4 — all must be clear.  Tests the longest-distance path clear
//  for a slider piece (queen diagonal is same as bishop).
//
//  We set up a custom board with an empty diagonal path but kings in place.
//
//  Expected: ~15 000 – 25 000 CU

#[test]
fn bench_04_queen_diagonal_long_path() {
    let mut board = emptyish_board_with_kings();
    // Place white queen on d1
    board[0][3] = Some((piece_type::QUEEN, player_color::WHITE));
    // Place white bishop at c1 (arbitrary extra piece, harmless)
    board[0][2] = Some((piece_type::BISHOP, player_color::WHITE));

    run_make_move_bench(
        "04 queen Qd1h5 (long diagonal path check)",
        "bench-04",
        &board,
        player_color::WHITE,
        0, 3,  // d1
        4, 7,  // h5
        None,
        12_000,
        28_000,
    );
}

// ── Benchmark 5: are_no_legal_moves midgame ────────────────────────────────
//
//  After white makes a move in a midgame position (~30 legal moves for
//  Black), the program calls are_no_legal_moves() for the opponent.
//  This function brute-force iterates 64×64 = 4096 source-dest pairs
//  for every piece of the opponent's color, simulating each candidate
//  move and checking for king safety.
//
//  We set up the Scotch Game midgame board and have White make a
//  developing move Nb1→c3.  The program then validates that Black still
//  has legal moves (~25-35 in this position).
//
//  Expected: ~80 000 – 150 000 CU  (heaviest benchmark)

#[test]
fn bench_05_are_no_legal_moves_midgame() {
    run_make_move_bench(
        "05 no-legal-moves check midgame (~30 opponent moves)",
        "bench-05",
        &midgame_board_def(),
        player_color::WHITE,
        0, 1,  // b1 (Nb1)
        2, 2,  // c3 (Nc3)
        None,
        60_000,
        170_000,
    );
}

// ── Benchmark 6: Full initialize_match instruction ─────────────────────────
//
//  Complete account initialization flow:
//    • PDA-derived ChessMatch account creation
//    • PDA-derived escrow token account creation
//    • SPL Token CPI transfer from player to escrow
//    • Event emission
//
//  NOTE: This benchmark requires the SPL Token program to be available
//  in the Mollusk SVM environment.  If the token program .so is not
//  provided, Mollusk will fail during the CPI.
//
//  To load the token program, Mollusk may need:
//    mollusk.add_program(&spl_token_id, "path/to/spl_token.so");
//
//  Expected: ~45 000 – 120 000 CU

#[test]
fn bench_06_initialize_match() {
    let prog_id = program_id();
    let mollusk = create_mollusk();

    let player = random_signer();
    let player_pubkey = player.pubkey();
    let match_id = "bench-init06";
    let bet_amount: u64 = 1_000_000;
    let move_timeout_duration: i64 = 900;
    let platform_fee_bps: u16 = 200;
    let platform_fee_wallet = Pubkey::new_unique();

    // PDA addresses
    let (match_pda, _match_bump) = find_chess_match_pda(match_id, &prog_id);
    let (escrow_pda, _escrow_bump) = find_match_escrow_pda(match_id, &prog_id);

    // Mint account — SPL Token mint (any non-zero pubkey)
    let mint = Pubkey::new_unique();

    // Player token account — we configure it to pass the Anchor constraints:
    //   owner == player_signer.key()
    //   mint  == betting_token_mint_account.key()
    //
    // Use a unique address for the ATA (not the same as player_pubkey, which
    // is used for the signer account).  Mollusk matches accounts by address.
    let player_ata_address = Pubkey::new_unique();

    let token_program_id = Pubkey::from_str(TOKEN_PROGRAM_ID_STR).unwrap();

    // SPL Token Mint account layout (82 bytes):
    //   [0..4]   mint_authority_option tag (u32)
    //   [4..36]  mint_authority (Pubkey, only valid if tag != 0)
    //   [36..44] supply (u64 LE)
    //   [44]     decimals (u8)
    //   [45]     is_initialized (bool)
    //   [46..50] freeze_authority_option tag (u32)
    //   [50..82] freeze_authority (Pubkey)
    let mint_data = {
        let mut d = vec![0u8; 82];
        // mint_authority_option: 0 = None (no mint authority)
        d[0..4].copy_from_slice(&0u32.to_le_bytes());
        // supply: 1_000_000_000
        d[36..44].copy_from_slice(&1_000_000_000u64.to_le_bytes());
        // decimals: 9
        d[44] = 9;
        // is_initialized: true
        d[45] = 1;
        // freeze_authority_option: 0 = None
        d[46..50].copy_from_slice(&0u32.to_le_bytes());
        d
    };
    let mint_account = account_from_bytes(mint_data, &token_program_id, 1_460_160);

    // SPL Token Account layout (165 bytes):
    //   [0..32]   mint (Pubkey)
    //   [32..64]  owner (Pubkey)
    //   [64..72]  amount (u64 LE)
    //   [72..76]  delegate_option tag (u32)
    //   [76..108] delegate (Pubkey)
    //   [108]     state (u8: 0=Uninitialized, 1=Initialized, 2=Frozen)
    //   [109..113] is_native_option tag (u32)
    //   [113..121] is_native (u64)
    //   [121..129] delegated_amount (u64)
    //   [129..133] close_authority_option tag (u32)
    //   [133..165] close_authority (Pubkey)
    let player_ata_data = {
        let mut d = vec![0u8; 165];
        // mint at offset 0
        d[0..32].copy_from_slice(&mint.to_bytes());
        // owner at offset 32
        d[32..64].copy_from_slice(&player_pubkey.to_bytes());
        // amount at offset 64 — must be >= bet_amount
        let bal: u64 = 10_000_000;
        d[64..72].copy_from_slice(&bal.to_le_bytes());
        // state: Initialized = 1
        d[108] = 1;
        d
    };
    let player_ata = account_from_bytes(player_ata_data, &token_program_id, 2_039_280);

    // Escrow token account — created by the program (init), so Mollusk
    // passes it as a writable account with zero-length data.
    let escrow_account = AccountSharedData::new(0, 165, &token_program_id);

    // Build instruction data
    let ix_data = build_init_match_ix_data(
        match_id,
        bet_amount,
        move_timeout_duration,
        platform_fee_bps,
        &platform_fee_wallet,
    );

    // Accounts in the same order as the InitializeMatch struct
    let account_metas = vec![
        AccountMeta::new(match_pda, false),        // chess_match (PDA, created by init)
        AccountMeta::new(player_pubkey, true),     // player_signer
        AccountMeta::new_readonly(mint, false),    // betting_token_mint_account
        AccountMeta::new(player_ata_address, false), // player_token_account
        AccountMeta::new(escrow_pda, false),       // match_escrow_token_account (PDA, created by init)
        AccountMeta::new_readonly(token_program_id, false), // token_program
        AccountMeta::new_readonly(
            solana_sdk::system_program::id(),
            false,
        ), // system_program
    ];
    let instruction = Instruction::new_with_bytes(prog_id, &ix_data, account_metas);

    // Assemble Mollusk accounts
    //
    // NOTE: For the token CPI to work, you must add the SPL Token program
    // to Mollusk.  Without it the CPI will fail with ProgramError.
    //
    //   mollusk.add_program(&token_program_id, "target/deploy/spl_token.so");
    //
    // The system program is built into Mollusk's SVM and does not need a
    // separate entry.
    let mollusk_accounts: Vec<(Pubkey, AccountSharedData)> = vec![
        // ChessMatch PDA — created by the init constraint (starts empty)
        (match_pda, AccountSharedData::new(0, 0, &solana_sdk::system_program::id())),
        // Player signer
        (
            player_pubkey,
            AccountSharedData::new(1_000_000_000, 0, &solana_sdk::system_program::id()),
        ),
        // Mint account
        (mint, mint_account),
        // Player ATA (with balance)
        (player_ata_address, player_ata),
        // Escrow PDA — created by init
        (escrow_pda, escrow_account),
    ];

    let result = mollusk.process_instruction(&instruction, &mollusk_accounts);
    let cu = result.compute_units_consumed;
    let status = if cu <= CU_BUDGET { "PASS" } else { "FAIL" };

    println!(
        "{status:>4} | 06 initialize_match (account setup + CPI)         | CU: {cu:>7}  (budget {CU_BUDGET})"
    );

    // Known issue: this benchmark will fail if SPL Token is not loaded in
    // Mollusk.  We print a diagnostic instead of a hard assert, so the
    // other benchmarks can still run via `cargo test`.
    //
    // The MolluskResult struct carries the program result in the
    // `program_result` field (name may vary across mollusk-svm versions;
    // check your version if this fails to compile).
    if result.program_result.is_err() {
        println!(
            "  NOTE: initialize_match CPI failed (token program may not be loaded in Mollusk)."
        );
        println!("  To enable: add spl_token.so via mollusk.add_program().");
    } else {
        assert!(cu <= CU_BUDGET);
    }
}

// ============================================================================
//  Summary runner (optional: run all benchmarks at once)
// ============================================================================

#[test]
fn run_all_benchmarks() {
    println!("╔══════════════════════════════════════════════════════════════════════╗");
    println!("║         Magic Chess — Mollusk CU Benchmarks                          ║");
    println!("║         Program: {PROGRAM_ID_STR}              ║");
    println!("║         Budget : {CU_BUDGET} CU                                        ║");
    println!("╚══════════════════════════════════════════════════════════════════════╝");
    println!();
    println!("{:>4} | {:<45} | {}", "STAT", "Benchmark", "CU Result");
    println!("{:-<4}-+-{:-<45}-+-{:-<20}", "----", "", "");

    // Re-run each benchmark inline (the individual #[test] fns also work
    // standalone, but this runner provides a unified summary table).
    bench_01_pawn_advance_baseline();
    bench_02_knight_move();
    bench_03_bishop_path_check();
    bench_04_queen_diagonal_long_path();
    bench_05_are_no_legal_moves_midgame();
    bench_06_initialize_match();

    println!();
    println!("All benchmarks complete.");
}
